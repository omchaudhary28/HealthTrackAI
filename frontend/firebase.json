{
  "hosting": {
    "public": "dist/mindtrack-ai/browser",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/health",
        "destination": "https://healthtrackai-v1ug.onrender.com/health",
        "type": 302
      },
      {
        "source": "/ready",
        "destination": "https://healthtrackai-v1ug.onrender.com/ready",
        "type": 302
      },
      {
        "source": "/api",
        "destination": "https://healthtrackai-v1ug.onrender.com/api/v1",
        "type": 302
      },
      {
        "source": "/api/**",
        "destination": "https://healthtrackai-v1ug.onrender.com/api/:splat",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/landing",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/about",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/auth",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/auth/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/dashboard",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
